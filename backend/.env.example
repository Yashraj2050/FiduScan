# ─── FiduScan Backend — Environment Variables ───────────────────────────────
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
#
# ─── Database ────────────────────────────────────────────────────────────────

DATABASE_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"

# ─── Supabase ─────────────────────────────────────────────────────────────────

SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SERVICE_KEY="<supabase-service-role-key>"
SUPABASE_ANON_KEY="<supabase-anon-key>"

# ─── JWT Authentication ───────────────────────────────────────────────────────
# REQUIRED — the server will refuse to start without this.
# Generate a strong secret with:
#   python3 -c "import secrets; print(secrets.token_hex(48))"

JWT_SECRET_KEY="<generate-a-long-random-secret>"

# ─── Stripe Billing ──────────────────────────────────────────────────────────

STRIPE_SECRET_KEY="sk_live_<your-stripe-secret-key>"
STRIPE_WEBHOOK_SECRET="whsec_<your-webhook-signing-secret>"

# ─── Resend (Transactional Email) ─────────────────────────────────────────────

RESEND_API_KEY="re_<your-resend-api-key>"

# ─── CORS ─────────────────────────────────────────────────────────────────────

CORS_ORIGINS="http://localhost:3000,https://your-huggingface-space-domain.hf.space"

# ─── Trust Agent (AI Reasoning Layer) ────────────────────────────────────────
# Optional. Set either OPENAI or GEMINI key to enable the Trust Agent.

TRUST_AGENT_PROVIDER="gemini"
TRUST_AGENT_API_KEY="<your-openai-or-gemini-api-key>"
